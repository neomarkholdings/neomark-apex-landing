{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Samurai",
  "version": "0.1.0",
  "identifier": "com.roninsoftworx.samurai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SAMURAI // サムライ — Ronin Softworx",
        "width": 1380,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 740,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
